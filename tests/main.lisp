(in-package #:cl-stringr/tests)

(define-test "Basic Operations"
  (is equalp #(5 nil 3) (str-length #("hello" nil "foo")))
  (is equalp #(1) (str-length "a"))
  
  (is equalp #("abcd" nil) (str-c #("ab" "cd") #("cd" nil)))
  (is equalp #("a1" "b2") (str-c #("a" "b") #("1" "2")))

  (is equalp #("hel" nil) (str-sub #("hello" nil) 0 3))
  (is equalp #("ell") (str-sub "hello" 1 4))

  (is equalp #("foo" nil "bar") (str-trim #("  foo  " nil "bar ")))
  
  (is equalp #("ABC" nil) (str-to-upper #("abc" nil)))
  (is equalp #("abc" nil) (str-to-lower #("ABC" nil)))
  (is equalp #("Hello World" nil) (str-to-title #("hello world" nil)))
  (is equalp #("Hello world" nil) (str-to-sentence #("HELLO WORLD" nil))))

(define-test "Pattern Matching"
  (is equalp #(t nil t) (str-detect #("apple" nil "banana") "a"))
  (is equalp #("apple" "pear" "banana") (str-subset #("apple" "pear" "banana") "a"))
  (is equalp #(1 1 3) (str-count #("apple" "pear" "banana") "a"))
  (is equalp #("app" nil "ban") (str-extract #("apple" nil "banana") "[a-z]{3}"))
  (let ((res (str-extract-all #("apple" "" "banana") "[a-z]")))
    (is equalp (elt (elt res 0) 0) "a")
    (is equalp (length (elt res 1)) 0)))

(define-test "Replacement"
  (is equalp #("a-pple" nil "b-anana") (str-replace #("apple" nil "banana") "([a-z])" "\\1-"))
  (is equalp #("a-p-p-l-e-" "" "b-a-n-a-n-a-") (str-replace-all #("apple" "" "banana") "([a-z])" "\\1-")))

(define-test "Splitting and Joining"
  (is equalp #(#("a" "b" "c") #("d" "e")) (str-split #("a,b,c" "d,e") ","))
  (is equal "a-b-c" (str-join #("a" "b" "c") "-"))
  (is equalp nil (str-join #("a" nil "c") "-")))

(define-test "String Interpolation"
  (let ((x "world"))
    (declare (ignorable x))
    (is equalp #("Hello world") (str-glue "Hello {x}" :x "world"))
    (is equalp #("a is 1, b is 2") (str-glue "a is {a}, b is {b}" :a 1 :b 2))))

(define-test "Lisp DSL"
  (with-str-context (name "Alice" age 30)
    (is equal "Hello Alice, age 30" (elt (glue "Hello {name}, age {age}") 0)))
  (with-str-context (:name "Bob" :age 40)
    (is equal "Hello Bob, age 40" (elt (glue "Hello {name}, age {age}") 0)))
  
  (is equalp #(5 nil 3) (map-str #'length #("hello" nil "foo"))))

(define-test "Missing values (cl-vctrs-lite:*na*)"
  ;; cl-readr represents missing cells as *na*; every op must propagate it
  ;; instead of signalling a type error. NIL inputs still give NIL.
  (let ((na cl-vctrs-lite:*na*))
    (is equalp (vector 5 na 1) (str-length (vector "hello" na "x")))
    (is equalp (vector "hi" na) (str-trim (vector " hi " na)))
    (is equalp (vector "HI" na) (str-to-upper (vector "hi" na)))
    (is equalp (vector t na nil) (str-detect (vector "hi" na "x") "h"))
    (is equalp (vector "hi!" na) (str-c (vector "hi" na) "!"))
    (is equalp (vector 1 na) (str-count (vector "hi" na) "h"))
    (is equalp (vector "Hi" na) (str-replace (vector "hi" na) "h" "H"))
    (is eq na (str-join (vector "a" na "c") "-"))
    (is equalp #("hi") (str-subset (vector "hi" na "x") "h"))
    (is equalp #(5 nil) (str-length #("hello" nil)))))

(define-test "SR1 modifier constructors and literal matching"
  (dolist (constructor (list #'regex #'fixed #'coll))
    (let ((p (funcall constructor (vector "a" cl-vctrs-lite:*na*))))
      (is eq t (pattern-object-p p))
      (is equalp (vector "a" cl-vctrs-lite:*na*) (pattern-values p))
      (is equalp #() (pattern-values (funcall constructor #())))
      (is eq t (handler-case (progn (funcall constructor "a" :ignore-case cl-vctrs-lite:*na*) nil)
                 (pattern-error () t)))))
  (is equalp #(nil t) (str-detect #("abb" "a.b") (fixed "a.b")))
  (is equalp #(t nil) (str-detect #("abc" "xyz") (regex "[a-c]+")))
  (is equalp #(t t t nil) (str-detect #("I" "ı" "i" "İ") (fixed "i" :ignore-case t)))
  (is equalp #(t nil) (str-detect #("ß" "ẞ") (fixed "ß" :ignore-case t)))
  (is equalp #(t t) (str-detect #("ß" "SS") (regex "ss" :ignore-case t)))
  (is equalp #("\\[a\\]\\(b\\)\\?" "- #") (str-escape #("[a](b)?" "- #")))
  (is equalp #("FALSE" "TRUE") (str-escape #(nil t)))
  (is equal '( ("x" . "\\.") ) (str-escape '(("x" . "."))))
  (is equalp #("X$\\1") (str-replace-all "a.b" (fixed "a.b") "X$\\1"))
  (is equalp #("aXbc") (str-replace "abc" (regex "(a)") "\\1X"))
  (is equalp #(nil t t) (str-detect #("I" "İ" "i") (coll "i" :ignore-case t :locale "tr")))
  (is equalp #(t) (str-equal "é" "é"))
  (is equalp #(t) (str-equal "Ω" "Ω")))

(define-test "SR1 Unicode boundaries and scalar recycling"
  (is equalp #(1) (str-count "👩‍👩‍👧‍👦" (boundary :character)))
  (is equalp #(1) (str-count "é" (boundary :character)))
  (is equalp #(#("These" "are" "some" "words"))
      (str-split "These are   some words." (boundary :word)))
  (is equalp #(#("a" "!")) (str-split "a!" (boundary :word :skip-word-none nil)))
  (is equalp #(#("a" "b" "")) (str-split "a,b," (fixed ",")))
  (is equalp #(#("" "a" "")) (str-split "a" (regex "^|$")))
  (is equalp #("a") (str-extract "💙a" (regex "a")))
  (is equalp #(2 1) (str-count #("a" "") (regex "^|$")))
  (is equalp #(t nil t) (str-detect "ab" (regex #("a" "x" "b"))))
  (is equalp #(t nil) (str-detect #("ab" "cd") (fixed #("a" "x"))))
  (is eq t (handler-case (progn (str-detect #("a" "b" "c") (regex #("a" "b"))) nil)
             (pattern-error () t)))
  (dolist (fn (list #'str-detect #'str-subset))
    (is eq t (handler-case (progn (funcall fn "a" (boundary :word)) nil) (pattern-error () t))))
  (is eq t (handler-case (progn (str-replace "a" (boundary :word) "X") nil) (pattern-error () t)))
  (is eq t (handler-case (progn (str-detect "a" (regex "[")) nil) (pattern-error () t))))

(define-test "SR1 prototypes, missing vectors and condition contract"
  (let ((na cl-vctrs-lite:*na*))
    (dolist (entry (list (cons #'str-detect :bool) (cons #'str-count :int)
                        (cons #'str-extract :string) (cons #'str-extract-all :list) (cons #'str-split :list)))
      (let ((empty (funcall (car entry) #() (regex "a")))
            (missing (funcall (car entry) (vector na) (regex "a"))))
        (is eq (cdr entry) (cl-vctrs-lite:col-type empty))
        (is eq (cdr entry) (cl-vctrs-lite:col-type missing))
        (is = 0 (length empty))
        (is = 1 (length missing))))
    (is equalp (vector (vector na)) (str-extract-all "a" (fixed na)))
    (is equalp (vector (vector na)) (str-split (vector na) (boundary :word)))
    (is eq :string (cl-vctrs-lite:col-type (str-escape #())))
    (is eq :string (cl-vctrs-lite:col-type (str-escape (vector na))))
    (is eq t (handler-case (regex "a" :ignore-case na) (cl-vctrs-lite:tidy-error () t)))
    (let ((warned nil))
      (handler-bind ((pattern-warning (lambda (c) (setf warned t) (muffle-warning c))))
        (str-detect "a" (fixed "")))
      (is eq t warned))))

(define-test "SR1 native initialization failure recovers"
  ;; Valid unrelated libraries and wrong ICU versions must not leave half-loaded
  ;; global state. These calls are isolated from the normal native engine.
  #+darwin
  (let ((cl-stringr::*icu-library* nil) (cl-stringr::*icu-suffix* nil)
        (cl-stringr::*icu-symbols* (make-hash-table :test #'equal)))
    (is eq t (handler-case (progn (cl-stringr::load-icu "/usr/lib/libSystem.B.dylib") nil)
               (pattern-error () t)))
    (is eq nil cl-stringr::*icu-library*)
    (is eq nil cl-stringr::*icu-suffix*)
    (is = 0 (hash-table-count cl-stringr::*icu-symbols*))
    (is eq t (handler-case (progn (cl-stringr::load-icu "/usr/lib/libicucore.A.dylib") nil)
               (pattern-error () t)))
    (is eq nil cl-stringr::*icu-library*)
    (is eq nil cl-stringr::*icu-suffix*)
    (is = 0 (hash-table-count cl-stringr::*icu-symbols*))
    (is eq t (not (null (cl-stringr::load-icu))))
    (when cl-stringr::*icu-library* (cl-stringr::close-icu-library cl-stringr::*icu-library*))))

(define-test "SR1 coercion and owned output types"
  (is equalp #("1" "2\\.5" "1e-06" "1e\\+08" "0\\.333333333333333")
      (str-escape #(1d0 2.5d0 1d-6 1d8 0.3333333333333333d0)))
  (is equalp #("a") (str-extract "abc" ""))
  (is eq t (handler-case (progn (str-detect "a" "") nil) (pattern-error () t)))
  (is eq :bool (cl-vctrs-lite:col-type (str-equal #() "a")))
  (is eq :bool (cl-vctrs-lite:col-type (str-equal (vector cl-vctrs-lite:*na*) "a")))
  (let* ((timestamp (local-time:encode-timestamp 123000000 5 4 3 2 1 2024 :timezone local-time:+utc-zone+))
         (date (cl-vctrs-lite:restore-column (vector timestamp cl-vctrs-lite:*na*) (cl-vctrs-lite:vec-prototype :date)))
         (datetime (cl-vctrs-lite:restore-column (vector timestamp cl-vctrs-lite:*na*) (cl-vctrs-lite:vec-prototype :datetime))))
    (is equalp (vector "2024-01-02" cl-vctrs-lite:*na*) (str-escape date))
    (is equalp (vector "2024-01-02 03:04:05\\.123" cl-vctrs-lite:*na*) (str-escape datetime)))
  (dolist (kind '(:bool :double))
    (let ((warned nil))
      (handler-bind ((pattern-warning (lambda (c) (setf warned t) (muffle-warning c))))
        (regex (cl-vctrs-lite:make-typed-column #() kind)))
      (is eq t warned))))

(define-test "SR1 nonfinite and hms character coercion"
  (is equalp #("Inf" "-Inf" "NaN")
      (str-escape (vector sb-ext:double-float-positive-infinity sb-ext:double-float-negative-infinity
                   (sb-kernel:make-double-float #x7ff80000 0))))
  (is equalp (vector "00:00:01\\.0" "00:00:01\\.5" cl-vctrs-lite:*na*)
      (str-escape (cl-vctrs-lite:make-typed-column (vector 1d0 1.5d0 cl-vctrs-lite:*na*) :time))))

(define-test "SR1 hms rounded zero and nonfinite alignment"
  (is equalp #("00:00:00\\.000000" "00:00:00\\.000000" "00:00:01\\.000000")
      (str-escape (cl-vctrs-lite:make-typed-column #(-1d-7 0d0 1d0) :time)))
  (is equalp (vector "Inf:NaN:NaNNaN" "-Inf:NaN:NaNNaN" cl-vctrs-lite:*na*
                    cl-vctrs-lite:*na* " 00:00:01\\.5")
      (str-escape (cl-vctrs-lite:make-typed-column
                   (vector sb-ext:double-float-positive-infinity sb-ext:double-float-negative-infinity
                     (sb-kernel:make-double-float #x7ff80000 0) cl-vctrs-lite:*na* 1.5d0) :time))))

(define-test "SR2 additive detection and retained names"
  (is equalp #(nil t) (cl-stringr:str-detect #("abc" "x") "a" :negate t))
  (is equalp #(t nil) (cl-stringr:str-starts #("apple" "banana") "a"))
  (is equalp #(t) (cl-stringr:str-ends "ababa" (cl-stringr:fixed "aba")))
  (is equalp #(t) (cl-stringr:str-ends "ababa" (cl-stringr:coll "aba")))
  (is equalp #(t nil) (cl-stringr:str-like #("a%b" "axb") "a\\%b"))
  (is equalp #(t) (cl-stringr:str-ilike "APPLE" "app%"))
  (is equalp #(nil) (cl-stringr:str-like "APPLE" "app%"))
  (is equalp #(0 2) (cl-stringr:str-which #("a" "x" "a") "a"))
  (let ((x (cl-vctrs-lite:make-typed-column #("a" "x") :string)))
    (setf (cl-vctrs-lite:col-names x) #("left" "right"))
    (let ((out (cl-stringr:str-detect x "a")))
      (is equalp #("left" "right") (cl-vctrs-lite:col-names out)))
    (let ((out (cl-stringr:str-subset x "a")))
      (is equalp #("a") out)
      (is equalp #("left") (cl-vctrs-lite:col-names out)))
    (is equalp #("left" "right") (cl-vctrs-lite:col-names x)))
  (is equalp #(2 1) (cl-stringr:str-count #("ab" "é"))))

(define-test "SR2 matrices and inclusive zero-based locations"
  (multiple-value-bind (matrix labels rows type) (cl-stringr:str-locate #("💙a" "x") "a")
    (is equal '(2 2) (array-dimensions matrix))
    (is equalp #("start" "end") labels)
    (is eq nil rows)
    (is eq :int type)
    (is = 1 (aref matrix 0 0))
    (is = 1 (aref matrix 0 1))
    (is eq cl-vctrs-lite:*na* (aref matrix 1 0)))
  (let ((matrix (cl-stringr:str-locate "ab" "$")))
    (is = 2 (aref matrix 0 0))
    (is = 1 (aref matrix 0 1)))
  (multiple-value-bind (matrix labels rows type) (cl-stringr:str-match #("a" "ab" "x") "(?<letter>a)(b)?")
    (is equal '(3 3) (array-dimensions matrix))
    (is equalp #("" "letter" "") labels)
    (is eq nil rows)
    (is eq :string type)
    (is equal "a" (aref matrix 0 1))
    (is eq cl-vctrs-lite:*na* (aref matrix 0 2))
    (is equal "b" (aref matrix 1 2)))
  (multiple-value-bind (matrices labels names type) (cl-stringr:str-match-all #("aa" "x") "(a)")
    (is equal '(2 2) (array-dimensions (cl-vctrs-lite:col-ref matrices 0)))
    (is equal '(0 2) (array-dimensions (cl-vctrs-lite:col-ref matrices 1)))
    (is equalp #(nil nil) labels)
    (is eq nil names)
    (is eq :string type))
  (multiple-value-bind (matrix labels names type) (cl-stringr:str-extract-all #("aa" "x") "a" :simplify t)
    (is equal '(2 2) (array-dimensions matrix))
    (is equal "" (aref matrix 1 0))
    (is eq nil labels)
    (is eq nil names)
    (is eq :string type))
  (let ((matrix (cl-stringr:invert-match (cl-vctrs-lite:col-ref (cl-stringr:str-locate-all "1 and 2" "[0-9]+") 0))))
    (is equal '(3 2) (array-dimensions matrix))
    (is = -1 (aref matrix 0 0))
    (is = -1 (aref matrix 0 1))
    (is = -2 (aref matrix 2 1))))

(define-test "SR2 options and matrix input validation"
  (dolist (thunk (list (lambda () (cl-stringr:str-match "a" (cl-stringr:fixed "a")))
                       (lambda () (cl-stringr:str-match "a" cl-vctrs-lite:*na*))
                       (lambda () (cl-stringr:str-locate #("a" "b") #("a" "b" "c")))
                       (lambda () (cl-stringr:str-like "a" (cl-stringr:fixed "a")))
                       (lambda () (cl-stringr:invert-match (make-array '(0 2))))
                       (lambda () (cl-stringr:str-detect "a" "a" :negate cl-vctrs-lite:*na*))))
    (is eq t (handler-case (progn (funcall thunk) nil) (cl-stringr:pattern-error () t))))
  (is equalp (vector "b" cl-vctrs-lite:*na*)
      (cl-stringr:str-extract #("ab" "a") "(a)(b)?" :group 1)))

(define-test "SR2 matrix metadata ownership and D12 list outputs"
  (multiple-value-bind (matrix columns rows type) (cl-stringr:str-locate "ab" "a")
    (declare (ignore rows type))
    (setf (aref columns 0) "changed")
    (multiple-value-bind (inverse labels) (cl-stringr:invert-match matrix)
      (is equalp #("start" "end") labels)
      (is equal '(2 2) (array-dimensions inverse))))
  (is eq t (listp (cl-stringr:str-locate-all #("a" "b") "a")))
  (is eq t (cl-vctrs-lite:named-list-p (cl-stringr:str-match-all '(("left" . "a") ("right" . "b")) "(a)")))
  (let ((input (cl-vctrs-lite:make-typed-column #("a" "b") :string)))
    (setf (cl-vctrs-lite:col-names input) (vector cl-vctrs-lite:*na* ""))
    (let ((out (cl-stringr:str-locate-all input "a")))
      (is eq :list (cl-vctrs-lite:col-type out))
      (is equalp (vector cl-vctrs-lite:*na* "") (cl-vctrs-lite:col-names out))))
  (is equalp #(0 1) (cl-stringr:str-count #(t nil) "FALSE")))

(define-test "SR2 capture column selectors retain matrix semantics"
  (multiple-value-bind (matrix labels rows type) (cl-stringr:str-extract #("ab" "a") "(?<first>a)(?<last>b)?" :group #(1 0))
    (is equal '(2 2) (array-dimensions matrix))
    (is equalp #("last" "first") labels)
    (is eq nil rows)
    (is eq :string type)
    (is equal "b" (aref matrix 0 0))
    (is eq cl-vctrs-lite:*na* (aref matrix 1 0)))
  (is equalp #("ab" "a") (cl-stringr:str-extract #("ab" "a") "(a)(b)?" :group -0.5d0))
  (is equal '(2 0) (array-dimensions (cl-stringr:str-extract #("ab" "a") "(a)(b)?" :group -2)))
  (is equal '(2 2) (array-dimensions (cl-stringr:str-extract #("ab" "a") "(a)(b)?" :group -3)))
  (is eq t (handler-case (progn (cl-stringr:str-extract #("ab" "a") "(a)(b)?" :group #(-3 0)) nil)
             (cl-stringr:pattern-error () t))))

(define-test "SR2 regex modifier NA differs from plain NA patterns"
  (multiple-value-bind (matrix labels rows type) (cl-stringr:str-match #("a" "ab") (cl-stringr:regex cl-vctrs-lite:*na*))
    (declare (ignore labels rows))
    (is equal '(2 1) (array-dimensions matrix))
    (is eq :string type)
    (is eq cl-vctrs-lite:*na* (aref matrix 1 0)))
  (let ((matrices (cl-stringr:str-match-all #("a" "ab") (cl-stringr:regex (vector cl-vctrs-lite:*na* "(a)(b)")))))
    (is equal '(1 1) (array-dimensions (first matrices)))
    (is equal '(1 3) (array-dimensions (second matrices)))))

(define-test "SR2 single row capture selections recycle row names"
  (let ((x (cl-stringr:str-extract '(("row" . "ab")) "(?<first>a)(?<last>b)" :group #(0 1))))
    (is equalp #("a" "b") x)
    (is equalp #("row" "row") (cl-vctrs-lite:col-names x)))
  (let ((x (cl-stringr:str-extract '(("row" . "ab")) "(?<first>a)(?<last>b)" :group #())))
    (is equalp #() x)
    (is equalp #() (cl-vctrs-lite:col-names x)))
  (let ((x (cl-stringr:str-extract '(("row" . "ab")) "(?<first>a)(?<last>b)" :group #(0 0))))
    (is equalp #("a" "a") x)
    (is equalp #("row" "row") (cl-vctrs-lite:col-names x)))
  (is equalp #("first" "last")
      (cl-vctrs-lite:col-names (cl-stringr:str-extract "ab" "(?<first>a)(?<last>b)" :group #(0 1))))
  (is eq nil (cl-vctrs-lite:col-names (cl-stringr:str-extract "ab" "(?<first>a)(?<last>b)" :group #()))))
